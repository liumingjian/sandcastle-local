{
  "name": "@liumingjian/sandcastle-local",
  "version": "0.1.0",
  "private": true,
  "description": "Reuse local Codex CLI authentication with Sandcastle and macOS Seatbelt",
  "type": "module",
  "bin": {
    "sandcastle-local": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:live": "tsx scripts/verify-live.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@ai-hero/sandcastle": "0.14.0",
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.0"
  }
}
